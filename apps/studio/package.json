{
  "name": "@b-studio/studio",
  "version": "0.3.0",
  "license": "MIT",
  "private": true,
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1",
    "build": "next build",
    "start": "next start --hostname 127.0.0.1",
    "lint": "eslint --max-warnings 0",
    "typecheck": "next typegen && tsc --noEmit -p .",
    "routes": "tsx server/gen-routes.ts",
    "server": "tsx --tsconfig tsconfig.json server/main.ts"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "0.3.267",
    "@b-studio/agent": "workspace:*",
