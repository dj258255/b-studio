{
  "name": "@b-studio/studio",
  "version": "0.3.0",
  "license": "MIT",
  "private": true,
  "scripts": {
    "dev": "tsx watch --tsconfig tsconfig.json server/main.ts",
    "start": "tsx --tsconfig tsconfig.json server/main.ts",
    "build": "tsx server/gen-routes.ts --check",
    "lint": "eslint --max-warnings 0",
    "typecheck": "tsc --noEmit -p .",
    "routes": "tsx server/gen-routes.ts",
    "server": "tsx --tsconfig tsconfig.json server/main.ts"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "0.3.267",
    "@b-studio/agent": "workspace:*",
    "@b-studio/sandbox": "workspace:*",
    "@b-studio/spec": "workspace:*",
    "zod": "^4.6.7",
    "tsx": "^4.23.13"
  },
  "devDependencies": {
    "@types/node": "^20",
    "eslint": "^9",
    "typescript": "^5",
    "typescript-eslint": "8.70.0"
  },
  "packageManager": "pnpm@10.29.3"
}
