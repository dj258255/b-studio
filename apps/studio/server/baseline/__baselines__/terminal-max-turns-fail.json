                          "value": {
                            "intValue": "10"
                          }
                        },
                        {
                          "key": "cost_usd",
                          "value": {
                            "doubleValue": 0.001
                          }
                        },
                        {
                          "key": "request_id",
                          "value": {
                            "stringValue": "turn-1"
                          }
                        }
                      ]
                    }
                  ]
                }
              ]
            }
          ]
        },
        "output": {}
      }
    },
    {
      "step": "턴 끝",
      "method": "HOOK",
      "path": "/stop",
      "status": 0,
      "body": {
        "input": {
          "session_id": "conversation-1",
          "cwd": "<root>/sessions/demo-<sid>",
          "transcript_path": "/dev/null",
