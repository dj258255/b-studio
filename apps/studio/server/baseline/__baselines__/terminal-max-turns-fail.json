      "body": {
        "input": {
          "session_id": "conversation-1",
          "cwd": "<root>/sessions/demo-<sid>",
          "transcript_path": "/dev/null",
          "hook_event_name": "PreToolUse",
          "tool_name": "Write",
          "tool_input": {
            "file_path": "<root>/sessions/demo-<sid>/app/hello.txt",
            "content": "상한 전 틀림\n"
          },
          "tool_use_id": "toolu_1"
        },
        "output": {}
      }
    },
    {
      "step": "모델 호출 1번(상한)",
