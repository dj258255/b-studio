{
  "http": [
    {
      "step": "세션 만들기",
      "method": "POST",
      "path": "/api/sessions",
      "status": 201,
      "body": {
        "id": "<sid>",
        "projectId": "demo",
        "projectName": "demo",
        "workDir": "<root>/sessions/demo-<sid>",
        "workspace": "copy",
        "status": "idle",
        "mode": "claude-code",
        "backend": "claude-code",
        "running": false,
        "owner": "local",
        "experimental": true,
        "terminal": true,
        "terminalMode": "host",
        "hasDeploy": false,
        "services": [
          {
            "name": "app",
            "template": "nextjs",
            "preview": "browser",
            "state": "stopped",
            "hasContract": false
          }
        ],
        "externals": [],
        "checkpoints": [
          {
            "sha": "<sha:1>",
            "shortSha": "<sha:1>",
            "message": "세션 시작 (main 브랜치)",
            "createdAt": "<createdAt>",
            "files": [
              "app/hello.txt",
              "app/readme.txt",
              "compose.yaml",
              "studio.yaml"
            ]
          }
        ],
        "repository": {
          "remote": "<root>/projects/demo",
          "kind": "local",
          "base": "main",
          "branch": "b-studio/demo-<sid>",
          "sourceDirtyFiles": 0,
          "canCreatePullRequest": false
        }
      }
    },
    {
      "step": "허용 켜기",
      "method": "POST",
      "path": "/api/sessions/<sid>/check-changes",
      "status": 200,
      "body": {
        "armed": true
      }
    },
    {
      "step": "켠 것 읽기",
      "method": "GET",
      "path": "/api/sessions/<sid>",
      "status": 200,
      "body": {
        "id": "<sid>",
        "projectId": "demo",
        "projectName": "demo",
        "workDir": "<root>/sessions/demo-<sid>",
