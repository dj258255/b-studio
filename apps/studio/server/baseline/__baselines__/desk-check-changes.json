        "hasDeploy": false,
        "services": [
          {
            "name": "app",
            "template": "nextjs",
            "preview": "browser",
            "state": "stopped",
            "hasContract": false
          }
        ],
        "externals": [],
        "checkpoints": [
          {
            "sha": "<sha:1>",
            "shortSha": "<sha:1>",
            "message": "세션 시작 (main 브랜치)",
            "createdAt": "<createdAt>",
            "files": [
              "app/hello.txt",
              "app/readme.txt",
              "compose.yaml",
              "studio.yaml"
            ]
          }
        ],
        "repository": {
          "remote": "<root>/projects/demo",
          "kind": "local",
          "base": "main",
          "branch": "b-studio/demo-<sid>",
          "sourceDirtyFiles": 0,
          "canCreatePullRequest": false
        },
        "allowCheckChangesNext": true
      }
    },
    {
      "step": "허용 끄기",
      "method": "POST",
      "path": "/api/sessions/<sid>/check-changes",
      "status": 200,
      "body": {
        "armed": false
      }
    },
    {
      "step": "boolean이 아닌 값",
      "method": "POST",
      "path": "/api/sessions/<sid>/check-changes",
      "status": 400,
      "body": {
        "error": "allow는 true나 false여야 합니다"
      }
    },
    {
      "step": "없는 세션",
      "method": "POST",
      "path": "/api/sessions/no-such-session/check-changes",
      "status": 404,
      "body": {
        "error": "세션을 찾을 수 없습니다"
      }
    }
  ],
