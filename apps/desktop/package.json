{
  "name": "@b-studio/desktop",
  "version": "0.3.0",
  "license": "MIT",
  "private": true,
  "description": "웹 스튜디오를 감싸는 얇은 Electron 껍데기. 화면은 스튜디오 서버가 준다",
  "main": "dist/main.js",
  "scripts": {
    "compile": "tsc -p tsconfig.build.json",
    "dev": "pnpm compile && electron dist/main.js",
    "start": "pnpm compile && electron dist/main.js",
    "build:app": "pnpm compile && electron-builder --mac dir --publish never",
    "typecheck": "tsc -p ."
  },
  "devDependencies": {
    "@types/node": "^22.20.2",
    "electron": "44.4.5",
    "electron-builder": "26.15.3"
  }
}
